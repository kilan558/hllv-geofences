# Runtime language: en (English) or de (German).
GEOFENCE_LANGUAGE=en

# Profile started automatically on first launch. Afterwards, each server's
# selected or stopped state is persisted and controlled through Discord.
GEOFENCE_PROFILE=midcap

# Inclusive player limits: the profile remains active at this number and stops
# matching at the next player (for example, 60 is punished; 61 is not).
GEOFENCE_MIDCAP_MAX_PLAYERS=60
GEOFENCE_MIDCAP_ADVANCED_MAX_PLAYERS=99
GEOFENCE_LASTCAP_MAX_PLAYERS=90

# Seconds a player may remain outside the permitted area before punishment.
GEOFENCE_PUNISH_AFTER_SECONDS=10

# Optional single-line message overrides. Leave commented to use the selected
# language. The generated default warning includes the punishment delay above.
# GEOFENCE_WARNING_MESSAGE=You are outside the designated play area. Return to the battlefield immediately.
# GEOFENCE_PUNISH_MESSAGE=You remained outside the designated play area.

# HLL: Vietnam world-to-grid geometry. Change these only for a calibrated map
# setup; the defaults match the bundled Vietnam maps.
GEOFENCE_SECTOR_SIZE=20000
GEOFENCE_CENTER_OFFSET_X=0
GEOFENCE_CENTER_OFFSET_Y=0

# Optional comma-separated player IDs that must never be warned or punished.
# WHITELIST=76561198000000001,76561198000000002

# Application logging. DEBUG is enabled by its presence, so keep it commented
# for normal info-level logging.
# DEBUG=1

# Discord bot identity and guild. Create a dedicated bot token and never commit
# the real value. The bot needs only the Guilds intent.
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_GUILD_ID=123456789012345678

# Optional dedicated event channels. Uncomment either or both as needed. Every
# configured channel ID must be a distinct text channel in the guild above.
# GEOFENCE_LOG_CHANNEL_ID=123456789012345679
# GEOFENCE_ERROR_LOG_CHANNEL_ID=123456789012345680

# Optional comma-separated Discord user/role allowlists. For a public or shared
# Discord server, configure at least one allowlist or restrict channel access.
# If both are empty, anyone who can view the control channel can press buttons.
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=

# Discord panel refresh and graceful worker shutdown timing.
STATUS_REFRESH_SECONDS=20
STATUS_REFRESH_TIMEOUT_SECONDS=8
WORKER_SHUTDOWN_SECONDS=15

# First HLL: Vietnam server (required).
HLL_SERVER_LABEL="HLL Vietnam Server 1"
HLL_HOST=192.0.2.10
HLL_PORT=7779
HLL_PASSWORD=replace-with-rcon-password
GEOFENCE_CHANNEL_S1_ID=123456789012345681

# Additional servers are optional. Keep numeric suffixes and Discord channel
# numbers contiguous. Each server gets its own independently controlled panel.
# HLL_SERVER_LABEL_2="HLL Vietnam Server 2"
# HLL_HOST_2=192.0.2.11
# HLL_PORT_2=7779
# HLL_PASSWORD_2=replace-with-second-rcon-password
# GEOFENCE_CHANNEL_S2_ID=123456789012345682

# Docker Compose runtime identity. The quick start creates bot-data for this
# default identity. If you change either value, change its directory ownership
# to the same numeric IDs before starting the service.
GEOFENCE_UID=1000
GEOFENCE_GID=1000
